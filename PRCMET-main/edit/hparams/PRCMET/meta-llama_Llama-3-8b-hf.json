{
    "layers": [
       4, 5, 6 ,7,8
    ],
    "clamp_norm_factor": 1,
    "layer_selection": "all",
    "fact_token": "subject_last",
    "v_num_grad_steps": 20,
    "v_lr": 0.5,
    "v_loss_layer": 31,
    "v_weight_decay": 0.5,
    "kl_factor": 0.0625,
    "rewrite_module_tmp": "model.layers.{}.mlp.down_proj",
    "rewrite_module_tmps": ["model.layers.{}.mlp.down_proj"],
    "layer_module_tmp": "model.layers.{}",
    "mlp_module_tmp": "model.layers.{}.mlp.down_proj",
    "attn_module_tmp": "model.layers.{}.self_attn.o_proj",
    "ln_f_module": "model.norm",
    "lm_head_module": "lm_head",
    "mom2_adjustment": true,
    "mom2_update_weight": 15000,
    "mom2_dataset": "wikipedia",
    "mom2_n_samples": 100000,
    "mom2_dtype": "float32",
    "nll_loss_factor": 1,
    "preservation_constraint": true,
    "beta_preserve": 0.1,
    "preserve_rho": 0.95,
    "preservation_mode": "anchors",
    "anchor_templates": [
        "{}",
        "This text is about {}.",
        "A short description of {}.",
        "What do you know about {}?",
        "What can you tell me about {}?"
    ],
    "anchor_max_count": 10000,
    "anchor_extraction_chunk_size": 128,
    "anchor_covariance_dtype": "float32",
    "relation_anchor_preservation": true,
    "relation_anchor_beta": 0.2,
    "relation_anchor_budget": 1024,
    "response_calibration": true,
    "response_calibration_alpha": 0.1,
    "response_calibration_max_ratio": 1.2,
    "response_calibration_solve_chunk_size": 256
}
