{
    "layers": [
         3, 4, 5, 6, 7, 8
    ],
    "clamp_norm_factor": 0.75,
    "layer_selection": "all",
    "fact_token": "subject_last",
    "v_num_grad_steps": 30,
    "v_lr": 0.2,
    "v_loss_layer": 27,
    "v_weight_decay": 0.5,
    "kl_factor": 1,
    "rewrite_module_tmp": "transformer.h.{}.attn.out_proj",
    "rewrite_module_tmps": ["transformer.h.{}.mlp.fc_out"],
    "layer_module_tmp": "transformer.h.{}",
    "mlp_module_tmp": "transformer.h.{}.mlp.fc_out",
    "attn_module_tmp": "transformer.h.{}.attn.out_proj",
    "ln_f_module": "transformer.ln_f",
    "lm_head_module": "lm_head",
    "mom2_adjustment": true,
    "mom2_update_weight": 6000,
    "mom2_dataset": "wikipedia",
    "mom2_n_samples": 100000,
    "mom2_dtype": "float32",
    "nll_loss_factor": 1,
    "preservation_constraint": true,
    "preservation_mode": "anchors",
    "beta_preserve": 0.05,
    "preserve_rho": 0.95,
    "anchor_templates": [
        "{}",
        "This text is about {}.",
        "A short description of {}.",
        "What do you know about {}?",
        "What can you tell me about {}?"
    ],
    "anchor_max_count": 10000,
    "anchor_extraction_chunk_size": 128,
    "anchor_covariance_dtype": "float32",
    "relation_anchor_preservation": true,
    "relation_anchor_beta": 0.2,
    "relation_anchor_budget": 1024,
    "response_calibration": true,
    "response_calibration_alpha": 0.1,
    "response_calibration_max_ratio": 1,
    "response_calibration_solve_chunk_size": 256
}
